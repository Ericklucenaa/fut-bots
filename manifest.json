{
  "manifest_version": 3,
  "name": "FUT Galeria Bot",
  "version": "1.2.0",
  "description": "Compra as cartas que faltam numa galeria do Paletools (até um preço máximo) e lista no mais barato.",
  "content_scripts": [
    {
      "matches": [
        "https://www.ea.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "FUT Galeria Bot"
  }
}