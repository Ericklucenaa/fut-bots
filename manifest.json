{
  "manifest_version": 3,
  "name": "FUT Bots",
  "version": "2.0.0",
  "description": "Snipe, Galeria e Relist para o EA FC Ultimate Team Web App, num painel só.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.ea.com/*"],
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    {
      "matches": ["https://www.ea.com/*"],
      "js": ["lib.js", "core.js", "snipe.js", "galeria.js", "relist.js", "widget.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Abrir o painel do FUT Bots"
  }
}
